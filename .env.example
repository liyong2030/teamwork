# ==============================================================
# 团队协同管理平台 —— 根环境变量模板（Docker Compose 使用）
# 用法：cp .env.example .env，然后填写必须项（标注 [必填]）
# ==============================================================

# --------------------------------------------------------------
# 数据库（PostgreSQL 容器）
# --------------------------------------------------------------
POSTGRES_DB=ctms
POSTGRES_USER=ctms
# [必填] 数据库口令，建议 32 位以上随机串
POSTGRES_PASSWORD=

# --------------------------------------------------------------
# 后端安全
# --------------------------------------------------------------
# [必填] JWT 签名密钥：openssl rand -base64 48
SECRET_KEY=
# Access Token 有效期（分钟），默认 8 小时
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Refresh Token 有效期（天），默认 7 天
REFRESH_TOKEN_EXPIRE_DAYS=7

# --------------------------------------------------------------
# 周报口径
# --------------------------------------------------------------
# 截止日为周几（1=周一 ... 5=周五 ... 7=周日）；5 表示周五
REPORT_DEADLINE_WEEKDAY=5
REPORT_DEADLINE_TIME=18:00
# 定版在下周的周几 + 时刻：1 + 09:30 表示「下周一 09:30」
REPORT_FINALIZE_OFFSET_HOURS=63.5
# 有效周报最少的正文字符数
REPORT_VALID_MIN_CHARS=20

# --------------------------------------------------------------
# 邮件提醒（SMTP_*_ 为空则关闭邮件，仅走站内消息）
# --------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
MAIL_FROM=

# --------------------------------------------------------------
# 前端站点
# --------------------------------------------------------------
# Nginx 暴露端口
WEB_PORT=80
# 允许跨域访问的前端地址（Nginx 同域反代时填站点根地址）
CORS_ORIGINS=http://localhost

# 时区与调度
TZ=Asia/Shanghai
SCHEDULER_ENABLED=true

# --------------------------------------------------------------
# 统一身份认证（SSO）
# 模式：后端代理校验 —— 登录页照旧提交账号密码，后端拿这对凭据去 IdP 校验。
# 只做认证，不同步组织架构。
# 说明：docker-compose 会把本文件挂载到容器 /app/.env 并直接读取，
# 因此这里新增的任何配置都会生效，无需改动 compose 文件。
# --------------------------------------------------------------
AUTH_SSO_ENABLED=false
# cas | oidc | ldap | saml（saml 需浏览器跳转，当前版本未实现）
AUTH_SSO_PROVIDER=cas
AUTH_SSO_LABEL=统一身份认证
# true：所有人默认走 SSO；false：按账号自身的 auth_source 决定
AUTH_SSO_DEFAULT=false
# IdP 通过但本地无同名账号时自动建号（落入「未分组」部门，普通成员）
AUTH_SSO_AUTO_CREATE=true
# IdP 通过且本地存在同名本地账号时自动绑定（超级管理员账号除外，保留应急通道）
AUTH_SSO_BIND_EXISTING=true
AUTH_SSO_TIMEOUT=8

# --- CAS（需服务端开启 REST 接口）---
CAS_SERVER_URL=https://cas.example.com
CAS_REST_PATH=/cas/v1/tickets
CAS_SERVICE_URL=https://teamwork.example.com/login
# false 时只换 TGT 即认为通过（CAS 未开放 service 校验场景）
CAS_REQUIRE_SERVICE_TICKET=true

# --- OIDC（password grant，需 IdP 为该 client 开启）---
OIDC_ISSUER=https://idp.example.com
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_VERIFY_SSL=true

# --- LDAP / AD ---
LDAP_SERVER_URI=ldap://ldap.example.com:389
# 直接 bind 模式（推荐）：{username} 会被替换成登录名
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
# 先查后 bind 模式：填 base_dn + user_filter，并视情况提供搜索账号
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_FULL_NAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_USE_SSL=false
LDAP_SEARCH_BIND_DN=
LDAP_SEARCH_BIND_PASSWORD=
