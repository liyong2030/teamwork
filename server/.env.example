# ===== 应用基础 =====
# dev | prod；prod 下关闭 docs、禁用自动建表提示
APP_ENV=dev
APP_NAME=团队协作管理系统
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# ===== 数据库 =====
# 开发 / 单机降级（Windows 裸跑推荐）
DATABASE_URL=sqlite:///./data/app.db
# 生产 PostgreSQL 示例（docker-compose 会自动覆盖）
# DATABASE_URL=postgresql+psycopg2://ctms:change_me@db:5432/ctms
SQL_ECHO=false

# ===== 安全 =====
# 生产必须更换！生成方式： python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=please_change_me_to_a_random_48_bytes_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 时区 =====
TZ=Asia/Shanghai

# ===== 周报口径 =====
# 截止：周五 18:00
REPORT_DEADLINE_WEEKDAY=5
REPORT_DEADLINE_TIME=18:00
# 定版：下周一 09:30
REPORT_FINALIZE_WEEKDAY=1
REPORT_FINALIZE_TIME=09:30
# 有效周报最少字数
REPORT_VALID_MIN_CHARS=20

# ===== 定时任务 =====
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# ===== 邮件提醒（留空则自动降级为纯站内消息） =====
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=团队协作管理系统
SMTP_USE_SSL=true
EMAIL_ENABLED=false

# ===== CORS（生产改为实际前端域名，逗号分隔） =====
CORS_ORIGINS=http://localhost:5173,http://localhost

# ===== 密码策略 =====
PASSWORD_MIN_LENGTH=10

# ===== 统一身份认证（SSO）=====
# 模式：后端代理校验 —— 登录页照旧提交账号密码，后端拿这对凭据去 IdP 校验。
# 只做认证，不同步组织架构。
AUTH_SSO_ENABLED=false
# cas | oidc | ldap | saml（saml 需浏览器跳转，当前版本未实现）
AUTH_SSO_PROVIDER=cas
AUTH_SSO_LABEL=统一身份认证
# true：所有人默认走 SSO；false：按账号自身的 auth_source 决定
AUTH_SSO_DEFAULT=false
# IdP 通过但本地无同名账号时自动建号（落入「未分组」部门，普通成员）
AUTH_SSO_AUTO_CREATE=true
# IdP 通过且本地存在同名本地账号时自动绑定（超级管理员账号除外，保留应急通道）
AUTH_SSO_BIND_EXISTING=true
AUTH_SSO_TIMEOUT=8

# --- CAS（需服务端开启 REST 接口）---
CAS_SERVER_URL=https://cas.example.com
CAS_REST_PATH=/cas/v1/tickets
CAS_SERVICE_URL=https://teamwork.example.com/login
# false 时只换 TGT 即认为通过（CAS 未开放 service 校验场景）
CAS_REQUIRE_SERVICE_TICKET=true

# --- OIDC（password grant，需 IdP 为该 client 开启）---
OIDC_ISSUER=https://idp.example.com
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email
OIDC_VERIFY_SSL=true

# --- LDAP / AD ---
LDAP_SERVER_URI=ldap://ldap.example.com:389
# 直接 bind 模式（推荐）：{username} 会被替换成登录名
LDAP_BIND_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=com
# 先查后 bind 模式：填 base_dn + user_filter，并视情况提供搜索账号
LDAP_BASE_DN=
LDAP_USER_FILTER=(uid={username})
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_FULL_NAME=cn
LDAP_ATTR_EMAIL=mail
LDAP_USE_SSL=false
LDAP_SEARCH_BIND_DN=
LDAP_SEARCH_BIND_PASSWORD=
